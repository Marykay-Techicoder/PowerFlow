# ─── Database (Neon PostgreSQL) ──────────────────────────────
# Get these from your Neon project dashboard: https://console.neon.tech
#
# DATABASE_URL is the pooled connection string (used by Prisma Client at runtime).
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
#
# DIRECT_URL is the direct (non-pooled) connection string (used by Prisma Migrate).
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Neon provides both in the connection details panel.
DATABASE_URL=""
DIRECT_URL=""

# ─── Better Auth ─────────────────────────────────────────────
# Secret used to sign session tokens. Generate a strong random string for production.
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The public URL of your app (used by Better Auth for redirects).
# For local development: http://localhost:3000
# For production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# ─── App (optional) ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
